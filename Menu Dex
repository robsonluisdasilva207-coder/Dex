local function obterCorJogador(p)
    if not p or not p.Parent then return Color3.fromRGB(0, 255, 150) end
    local char = p.Character
    local backpack = p:FindFirstChildOfClass("Backpack")
    local temArma = false
    local temFaca = false
    local itens = {}
    
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do table.insert(itens, item) end
    end
    if char then
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") then table.insert(itens, item) end
        end
    end
    
    for _, item in pairs(itens) do
        local nomeItem = item.Name:lower()
        if string.find(nomeItem, "knife") or string.find(nomeItem, "faca") or string.find(nomeItem, "slasher") or string.find(nomeItem, "murder") then
            temFaca = true
        elseif string.find(nomeItem, "gun") or string.find(nomeItem, "revolver") or string.find(nomeItem, "pistol") or string.find(nomeItem, "arma") or string.find(nomeItem, "sheriff") then
            temArma = true
        end
    end
    
    if temFaca then
        return Color3.fromRGB(255, 50, 50)
    elseif temArma then
        return Color3.fromRGB(50, 150, 255)
    end
    
    if p.Team then
        local nomeTime = p.Team.Name:lower()
        if string.find(nomeTime, "murder") or string.find(nomeTime, "assas") or string.find(nomeTime, "bandit") or string.find(nomeTime, "beast") or string.find(nomeTime, "terror") then
            return Color3.fromRGB(255, 50, 50)
        elseif string.find(nomeTime, "sheriff") or string.find(nomeTime, "police") or string.find(nomeTime, "hero") or string.find(nomeTime, "guard") then
            return Color3.fromRGB(50, 150, 255)
        end
    end
    return Color3.fromRGB(0, 255, 150)
end

local function aplicarESP(p)
    if p == player then return end
    local function criarElementos(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if not head then return end
        
        local antigoHighlight = char:FindFirstChild("ESPHighlight")
        if antigoHighlight then antigoHighlight:Destroy() end
        local antigaTag = head:FindFirstChild("ESPTag")
        if antigaTag then antigaTag:Destroy() end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.FillColor = obterCorJogador(p)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.2
        highlight.Parent = char
        table.insert(espFolders, highlight)
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPTag"
        billboard.Size = UDim2.new(0, 100, 0, 30)
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.Parent = head
        table.insert(espFolders, billboard)
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = obterCorJogador(p)
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 10
        label.Text = p.DisplayName .. " [0m]"
        label.Parent = billboard
    end
    if p.Character then criarElementos(p.Character) end
    p.CharacterAdded:Connect(criarElementos)
end

