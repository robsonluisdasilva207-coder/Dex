-- 3. Sequência de animação em segundo plano
task.spawn(function()
    local introTweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    -- Fade In: A névoa branca e o título surgem suavemente
    TweenService:Create(introBackground, introTweenInfo, { BackgroundTransparency = 0.88 }):Play()
    TweenService:Create(introText, introTweenInfo, { TextTransparency = 0.1 }):Play()
    task.wait(1)
    
    -- Efeito de piscar sutil (Blink) simulando variação de transparência
    local tempoDecorrido = 0
    while tempoDecorrido < 2 do
        TweenService:Create(introText, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0.5 }):Play()
        TweenService:Create(introBackground, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.93 }):Play()
        task.wait(0.4)
        TweenService:Create(introText, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { TextTransparency = 0.1 }):Play()
        TweenService:Create(introBackground, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.88 }):Play()
        task.wait(0.4)
        tempoDecorrido = tempoDecorrido + 0.8
    end
    
    -- Fade Out: Desvanecimento completo de toda a cena
    local fadeOutInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(introBackground, fadeOutInfo, { BackgroundTransparency = 1 }):Play()
    local textFade = TweenService:Create(introText, fadeOutInfo, { TextTransparency = 1 })
    textFade:Play()
    
    -- Espera a transição acabar para remover os objetos e exibir o menu
    textFade.Completed:Wait()
    
    introBackground:Destroy()
    introText:Destroy()
    
    -- Exibe o menu principal expandindo ele verticalmente de forma bem fluida
    mainFrame.Visible = true
    mainFrame.Size = UDim2.new(0, 150, 0, 0)
    TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 150, 0, 190) }):Play()
end)

