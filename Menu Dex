local function aplicarModificacoesPersonagem(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    
    if humanoid then
        if configs.velocidade.ativa then
            humanoid.WalkSpeed = configs.velocidade.valor
        end
        if configs.pulo.ativa then
            if humanoid.UseJumpPower then
                humanoid.JumpPower = configs.pulo.valor
            else
                humanoid.JumpHeight = configs.pulo.valor / 3.5
            end
        end
    end
    
    if configs.voar.ativa and rootPart then
        task.wait(0.2)
        if bodyGyro then bodyGyro:Destroy() end
        if bodyVelocity then bodyVelocity:Destroy() end
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.P = 9e4
        bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.cframe = rootPart.CFrame
        bodyGyro.Parent = rootPart
        
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.velocity = Vector3.new(0, 0.1, 0)
        bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Parent = rootPart
        
        task.spawn(function()
            local camera = workspace.CurrentCamera
            while configs.voar.ativa and rootPart and rootPart.Parent do
                local dir = camera.CFrame.LookVector * 1.5
                bodyVelocity.velocity = dir * configs.voar.valor
                bodyGyro.cframe = camera.CFrame
                task.wait()
            end
        end)
    end
end

player.CharacterAdded:Connect(function(character)
    aplicarModificacoesPersonagem(character)
end)

