-- 8. Voar (Fly com Pose Estática Total) 
criarBotaoLista("voar", function(btn)
    abrirConfiguracao(
        "VOAR", btn, true,
        configs.voar.ativa,
        function(val)
            if val then configs.voar.valor = val end
        end,
        function(estado, val)
            configs.voar.ativa = estado
            if val and val ~= "" then 
                configs.voar.valor = val 
            else
                configs.voar.valor = 70
                valueInput.Text = "70"
            end
            
            if flyConn then flyConn:Disconnect() flyConn = nil end
            
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local animateScript = char and char:FindFirstChild("Animate")
            
            if estado and root and hum then
                --  Para qualquer movimento residual inicial
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                --  Força o estado em pé por um instante
                hum:ChangeState(Enum.HumanoidStateType.Running)
                
                -- Desativa o script de animação padrão
                if animateScript then
                    animateScript.Disabled = true
                end
                
                -- Para todas as animações que estiverem tocando
                local animator = hum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end
                end
                
                bodyGyro = Instance.new("BodyGyro")
                bodyGyro.P = 9e4
                bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
                bodyGyro.cframe = root.CFrame
                bodyGyro.Parent = root
                
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.velocity = Vector3.new(0, 0, 0)
                bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
                bodyVelocity.Parent = root
                
                hum:ChangeState(Enum.HumanoidStateType.Physics)
                
                -- Conexão de voo ativa
                flyConn = RunService.Stepped:Connect(function()
                    local camera = workspace.CurrentCamera
                    local personagem = player.Character
                    local tronco = personagem and personagem:FindFirstChild("HumanoidRootPart")
                    local humanoide = personagem and personagem:FindFirstChildOfClass("Humanoid")
                    
                    if configs.voar.ativa and tronco and camera and humanoide then
                        --  Força todos os Motor6D a ficarem na pose padrão reta (idle) a cada quadro
                        for _, motor in pairs(personagem:GetDescendants()) do
                            if motor:IsA("Motor6D") then
                                motor.Transform = CFrame.new()
                            end
                        end
                        
                        -- Desativa colisões para atravessar o mapa flutuando
                        for _, part in pairs(personagem:GetDescendants()) do
                            if part:IsA("BasePart") then 
                                part.CanCollide = false 
                            end
                        end
                        
                        local moveDir = humanoide.MoveDirection
                        
                        if moveDir.Magnitude > 0 then
                            local localMoveDir = camera.CFrame:VectorToObjectSpace(moveDir)
                            local direcaoFinal = camera.CFrame:VectorToWorldSpace(Vector3.new(localMoveDir.X, 0, localMoveDir.Z))
                            
                            if direcaoFinal.Magnitude > 0 then
                                direcaoFinal = direcaoFinal.Unit
                            end
                            bodyVelocity.velocity = direcaoFinal * configs.voar.valor
                        else
                            bodyVelocity.velocity = Vector3.new(0, 0, 0)
                        end
                        bodyGyro.cframe = camera.CFrame
                    else
                        if flyConn then flyConn:Disconnect() flyConn = nil end
                    end
                end)
            else
                --  Restaura o personagem ao estado normal ao desligar o voo
                if bodyGyro then bodyGyro:Destroy() end
                if bodyVelocity then bodyVelocity:Destroy() end
                if animateScript then
                    animateScript.Disabled = false
                end
                if hum then 
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end
    )
end)

