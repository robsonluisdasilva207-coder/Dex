local function fecharAbaLateral(targetY)
    local goal = { Position = UDim2.new(0, 0, 0, targetY or sideFrame.Position.Y.Offset) }
    local tween = TweenService:Create(sideFrame, tweenInfo, goal)
    tween:Play()
    tween.Completed:Connect(function()
        if activeConfig == nil then
            sideFrame.Visible = false
        end
    end)
end

local function abrirConfiguracao(nome, botaoOrigem, temInput, statusInicial, aoSalvar, aoMudarStatus)
    -- 1. Limpeza total de qualquer lista ou scroll anterior
    for _, child in pairs(sideFrame:GetChildren()) do
        if child:IsA("ScrollingFrame") or (child:IsA("TextButton") and child.Name ~= "ToggleContainer") then
            child:Destroy()
        end
    end

    -- 2. Define o tamanho ideal da aba de forma inteligente
    if nome == "Espectador" then
        sideFrame.Size = UDim2.new(0, 125, 0, 100) 
    elseif nome == "Teleporte" then
        sideFrame.Size = UDim2.new(0, 125, 0, 80)
    else
        sideFrame.Size = UDim2.new(0, 125, 0, 65)  
    end

    local relativeY = botaoOrigem.AbsolutePosition.Y - mainFrame.AbsolutePosition.Y
    local minY = 28
    local maxY = mainFrame.AbsoluteSize.Y - sideFrame.Size.Y.Offset - 4
    local targetY = math.clamp(relativeY - (sideFrame.Size.Y.Offset / 2) + (botaoOrigem.Size.Y.Offset / 2), minY, maxY)

    if activeConfig == nome then
        activeConfig = nil
        fecharAbaLateral(targetY)
        return
    end

    activeConfig = nome
    sideTitle.Text = nome:upper()
    
    -- Controla a visibilidade do Switch e da Caixa de Texto
    if nome == "Teleporte" then
        valueInput.Visible = false
        toggleContainer.Visible = false
    else
        toggleContainer.Visible = true
        if temInput then
            valueInput.Visible = true
            toggleContainer.Size = UDim2.new(0.28, 0, 0, 18)
            toggleContainer.Position = UDim2.new(0.66, 0, 0, 28)
        else
            valueInput.Visible = false
            toggleContainer.Size = UDim2.new(0.4, 0, 0, 18)
            if nome == "Espectador" then
                toggleContainer.Position = UDim2.new(0.3, 0, 0, 24)
            else
                toggleContainer.Position = UDim2.new(0.3, 0, 0, 31)
            end
        end
    end
    
    local ativo = statusInicial
    
    local function animarSwitch(bool)
        if bool then
            TweenService:Create(toggleContainer, tweenInfo, { BackgroundColor3 = Color3.fromRGB(52, 152, 219) }):Play()
            local circleX = temInput and -16 or -20
            TweenService:Create(toggleCircle, tweenInfo, { Position = UDim2.new(1, circleX, 0.5, -7) }):Play()
        else
            TweenService:Create(toggleContainer, tweenInfo, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }):Play()
            TweenService:Create(toggleCircle, tweenInfo, { Position = UDim2.new(0, 2, 0.5, -7) }):Play()
        end
    end
    animarSwitch(ativo)
    
    if activeSideConn1 then activeSideConn1:Disconnect() end
    if activeSideConn2 then activeSideConn2:Disconnect() end
    
    activeSideConn1 = toggleContainer.MouseButton1Click:Connect(function()
        ativo = not ativo
        animarSwitch(ativo)
        aoMudarStatus(ativo, tonumber(valueInput.Text) or valueInput.Text)
    end)
    
    activeSideConn2 = valueInput.FocusLost:Connect(function()
        aoSalvar(tonumber(valueInput.Text) or valueInput.Text, ativo)
    end)
    
    sideFrame.Position = UDim2.new(0, 0, 0, targetY)
    sideFrame.Visible = true
    
    TweenService:Create(sideFrame, tweenInfo, { Position = UDim2.new(0, -130, 0, targetY) }):Play()
end

