local BtnTPItem, ListaItens, MainItem, SetaItem, LayoutItens = CriarEstruturaLista("TP Items")

local function FiltrarCategoriaItem(obj)
    local lower = string.lower(obj.Name)
    if string.find(lower, "teleport") or string.find(lower, "placa") or string.find(lower, "portal") or string.find(lower, "door") or string.find(lower, "porta") then
        return "Portais e Placas"
    else
        return "Itens do Chão"
    end
end

local function CriarBotaoCategoriaItem(nomeCategoria)
    local CatBtn = Instance.new("TextButton")
    EstilitarBotaoMenu(CatBtn, "   ¤ Tipo: " .. nomeCategoria, true)
    CatBtn.BackgroundColor3 = Color3.fromRGB(12, 25, 25)
    CatBtn.TextColor3 = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
    CatBtn.ZIndex = 5
    CatBtn.Parent = ListaItens
end

local function AtualizarListaItens()
    for _, child in ipairs(ListaItens:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local itensAchados = {}
    pcall(function()
        for _, obj in ipairs(game.Workspace:GetChildren()) do
            local ehItem = obj:IsA("Tool") 
                or obj:FindFirstChildOfClass("ClickDetector") 
                or obj:FindFirstChildOfClass("ProximityPrompt")
                or string.find(string.lower(obj.Name), "item") 
                or string.find(string.lower(obj.Name), "drop")

            if ehItem and not game.Players:GetPlayerFromCharacter(obj) then
                local parteAlvo = nil
                if obj:IsA("BasePart") then
                    parteAlvo = obj
                elseif obj:IsA("Model") or obj:IsA("Tool") then
                    parteAlvo = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
                end
                
                if parteAlvo then
                    local cat = FiltrarCategoriaItem(obj)
                    if not itensAchados[cat] then itensAchados[cat] = {} end
                    table.insert(itensAchados[cat], {Objeto = obj, Parte = parteAlvo})
                end
            end
        end
    end)
    
    for categoria, listaDeItens in pairs(itensAchados) do
        CriarBotaoCategoriaItem(categoria)
        for _, dados in ipairs(listaDeItens) do
            local ItemBtn = Instance.new("TextButton")
            EstilitarBotaoMenu(ItemBtn, "         ¤ " .. dados.Objeto.Name, true)
            ItemBtn.ZIndex = 5
            ItemBtn.Parent = ListaItens
            
            ItemBtn.MouseButton1Click:Connect(function()
                if dados.Parte and dados.Parte:IsA("BasePart") then
                    TeleportarSeguro(dados.Parte.Position)
                end
            end)
        end
    end
    ListaItens.Size = UDim2.new(1, 0, 0, LayoutItens.AbsoluteContentSize.Y)
end

VincularAcaoLista(BtnTPItem, ListaItens, MainItem, SetaItem, LayoutItens, AtualizarListaItens)

