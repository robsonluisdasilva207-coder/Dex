CreateSectionLabel(TeleportPage, "Locais Disponíveis")

-- =============================================================================
-- [ESTRUTURA DA INTERFACE DINÂMICA DE TELEPORTE]
-- =============================================================================
local UIConfig = {
    LarguraBotoes = UDim2.new(1, -6, 0, 32),
    AlturaItemLista = 30
}

-- Variáveis Globais de Controle
local LocaisSalvos = {}
local CheckpointSeguranca = nil

_G.dasher_ativo = _G.dasher_ativo or false
_G.tp_seguranca_ativo = _G.tp_seguranca_ativo or false
_G.raio_seguranca = _G.raio_seguranca or 50

-- Função auxiliar para estilizar os botões principais e da lista
local function EstilitarBotaoMenu(botao, texto, ehItemLista)
    botao.Text = texto
    botao.Font = Enum.Font.SourceSansBold
    botao.TextColor3 = Color3.fromRGB(190, 190, 190)
    botao.TextXAlignment = Enum.TextXAlignment.Left
    
    if ehItemLista then
        botao.Size = UDim2.new(1, -6, 0, UIConfig.AlturaItemLista)
        botao.TextSize = 12
        botao.BackgroundTransparency = 0.85
        botao.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    else
        botao.Size = UDim2.new(1, 0, 0, 32)
        botao.TextSize = 13
        botao.BackgroundTransparency = 1
    end
    
    if ehItemLista then
        local UICorner = Instance.new("UICorner")
        UICorner.CornerRadius = UDim.new(0, 5)
        UICorner.Parent = botao
        
        local itemStroke = Instance.new("UIStroke")
        itemStroke.Color = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
        itemStroke.Transparency = 0.85
        itemStroke.Name = "TemaStroke"
        itemStroke.Parent = botao
    end
end

-- Função de teleporte segura
local function TeleportarSeguro(posicaoAlvo)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local posicaoRecuada = posicaoAlvo + Vector3.new(0, 3, 0)
        player.Character.HumanoidRootPart.CFrame = CFrame.new(posicaoRecuada)
    end
end

-- Configuração do Layout na página mestre
local LayoutPrincipal = TeleportPage:FindFirstChildOfClass("UIListLayout")
if not LayoutPrincipal then
    LayoutPrincipal = Instance.new("UIListLayout")
    LayoutPrincipal.SortOrder = Enum.SortOrder.LayoutOrder
    LayoutPrincipal.Padding = UDim.new(0, 6)
    LayoutPrincipal.Parent = TeleportPage
end

LayoutPrincipal:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    TeleportPage.CanvasSize = UDim2.new(0, 0, 0, LayoutPrincipal.AbsoluteContentSize.Y + 15)
end)

-- Construtor Estrutural das Listas Retráteis
local function CriarEstruturaLista(nomeBotao)
    local MainItem = Instance.new("Frame")
    MainItem.Size = UDim2.new(1, -6, 0, 32)
    MainItem.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    MainItem.BackgroundTransparency = 0.75
    MainItem.ClipsDescendants = true
    MainItem.ZIndex = 4
    MainItem.Parent = TeleportPage
    Instance.new("UICorner", MainItem).CornerRadius = UDim.new(0, 5)
    
    local itemStroke = Instance.new("UIStroke", MainItem)
    itemStroke.Color = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
    itemStroke.Transparency = 0.7
    itemStroke.Name = "TemaStroke"

    local TitleButton = Instance.new("TextButton")
    EstilitarBotaoMenu(TitleButton, "   " .. nomeBotao, false)
    TitleButton.ZIndex = 5
    TitleButton.Parent = MainItem
    
    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 0, 32)
    Arrow.Position = UDim2.new(1, -26, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "●"
    Arrow.TextColor3 = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
    Arrow.Name = "TemaTexto"
    Arrow.Font = Enum.Font.SourceSansBold
    Arrow.TextSize = 11
    Arrow.ZIndex = 5
    Arrow.Parent = TitleButton
    
    local FrameLista = Instance.new("Frame")
    FrameLista.Size = UDim2.new(1, -12, 0, 0)
    FrameLista.Position = UDim2.new(0, 6, 0, 36)
    FrameLista.BackgroundTransparency = 1
    FrameLista.ZIndex = 5
    FrameLista.Parent = MainItem
    
    local ListaLayout = Instance.new("UIListLayout")
    ListaLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListaLayout.Padding = UDim.new(0, 4)
    ListaLayout.Parent = FrameLista
    
    return TitleButton, FrameLista, MainItem, Arrow, ListaLayout
end

-- Gerenciador de Animação das Listas
local function VincularAcaoLista(botao, lista, mainItem, seta, layoutLista, funcaoAtualizar)
    local isOpen = false
    botao.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        seta.Text = isOpen and "○" or "●"
        
        local targetHeight = 32
        if isOpen then
            pcall(funcaoAtualizar)
            targetHeight = 38 + layoutLista.AbsoluteContentSize.Y
        end
        
        mainItem:TweenSize(UDim2.new(1, -6, 0, targetHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
    end)
end

-- =============================================================================
-- 0. SISTEMA DE MARCAR LOCAIS
-- =============================================================================
local BtnSpawn, ListaSpawn, MainSpawn, SetaSpawn, LayoutSpawn = CriarEstruturaLista("Locais Salvos")

local function AtualizarOpcoesSpawn()
    for _, child in ipairs(ListaSpawn:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local BtnSetar = Instance.new("TextButton")
    EstilitarBotaoMenu(BtnSetar, "      ¤ Marcar Local Atual", true)
    BtnSetar.ZIndex = 5
    BtnSetar.Parent = ListaSpawn
    
    BtnSetar.MouseButton1Click:Connect(function()
        local player = game.Players.LocalPlayer
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if #LocaisSalvos < 10 then
                table.insert(LocaisSalvos, player.Character.HumanoidRootPart.CFrame)
                AtualizarOpcoesSpawn()
                MainSpawn:TweenSize(UDim2.new(1, -6, 0, 38 + LayoutSpawn.AbsoluteContentSize.Y), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
            else
                BtnSetar.Text = "      ¤ Limite de 10 locais atingido!"
                task.wait(1.5)
                BtnSetar.Text = "      ¤ Marcar Local Atual"
            end
        end
    end)

    for i, cf in ipairs(LocaisSalvos) do
        local BtnLocal = Instance.new("TextButton")
        EstilitarBotaoMenu(BtnLocal, "         ¤ Local " .. i, true)
        BtnLocal.ZIndex = 5
        BtnLocal.Parent = ListaSpawn
        
        BtnLocal.MouseButton1Click:Connect(function()
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = cf
                table.remove(LocaisSalvos, i)
                AtualizarOpcoesSpawn()
                MainSpawn:TweenSize(UDim2.new(1, -6, 0, 38 + LayoutSpawn.AbsoluteContentSize.Y), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
            end
        end)
    end

    ListaSpawn.Size = UDim2.new(1, 0, 0, LayoutSpawn.AbsoluteContentSize.Y)
end

VincularAcaoLista(BtnSpawn, ListaSpawn, MainSpawn, SetaSpawn, LayoutSpawn, AtualizarOpcoesSpawn)

-- =============================================================================
-- 1. CONFIGURAÇÃO DO BOTÃO: TP PLAYER
-- =============================================================================
local BtnTPPlayer, ListaPlayers, MainPlayer, SetaPlayer, LayoutPlayers = CriarEstruturaLista("TP Player")

local function AtualizarListaPlayers()
    for _, child in ipairs(ListaPlayers:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local localPlayer = game.Players.LocalPlayer
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= localPlayer then
            local ItemBtn = Instance.new("TextButton")
            EstilitarBotaoMenu(ItemBtn, "      ¤ " .. p.DisplayName, true)
            ItemBtn.ZIndex = 5
            ItemBtn.Parent = ListaPlayers
            
            ItemBtn.MouseButton1Click:Connect(function()
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    TeleportarSeguro(p.Character.HumanoidRootPart.Position)
                end
            end)
        end
    end
    ListaPlayers.Size = UDim2.new(1, 0, 0, LayoutPlayers.AbsoluteContentSize.Y)
end

VincularAcaoLista(BtnTPPlayer, ListaPlayers, MainPlayer, SetaPlayer, LayoutPlayers, AtualizarListaPlayers)

