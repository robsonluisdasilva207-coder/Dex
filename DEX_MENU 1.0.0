-- 4. Mostrar FPS e Ping em Tempo Real
local StatsService = game:GetService("Stats")
local FpsGui, FpsFrame, FpsTextLabel, FpsConnection, StatsTask

CreateFunItem(MenuPage, "Mostrar FPS e Ping", "MostrarFPS", function(state)
    if ScriptStates["MostrarFPS"] then ScriptStates["MostrarFPS"].Active = state end

    if state then
        if not FpsGui then
            FpsGui = Instance.new("ScreenGui")
            FpsGui.Name = "FPS_Ping_Display"
            FpsGui.ResetOnSpawn = false
            
            local success = pcall(function() FpsGui.Parent = game:GetService("CoreGui") end)
            if not success then FpsGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

            FpsFrame = Instance.new("Frame")
            FpsFrame.Name = "FpsFrame"
            FpsFrame.Size = UDim2.new(0, 120, 0, 22)
            FpsFrame.Position = UDim2.new(0.5, -60, 0, 12)
            FpsFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            FpsFrame.BackgroundTransparency = 0.2
            FpsFrame.BorderSizePixel = 0
            FpsFrame.Active = true
            FpsFrame.Draggable = true
            FpsFrame.Parent = FpsGui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 5)
            corner.Parent = FpsFrame

            local stroke = Instance.new("UIStroke")
            stroke.Name = "TemaStroke"
            stroke.Color = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
            stroke.Transparency = 0.2
            stroke.Thickness = 1.5
            stroke.Parent = FpsFrame

            FpsTextLabel = Instance.new("TextLabel")
            FpsTextLabel.Name = "FpsLabel"
            FpsTextLabel.Size = UDim2.new(1, 0, 1, 0)
            FpsTextLabel.BackgroundTransparency = 1
            FpsTextLabel.Font = Enum.Font.GothamBlack
            FpsTextLabel.TextSize = 11
            FpsTextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            FpsTextLabel.Text = "FPS: -- | PING: --"
            FpsTextLabel.Parent = FpsFrame

            local textStroke = Instance.new("UIStroke")
            textStroke.Color = Color3.fromRGB(0, 0, 0)
            textStroke.Thickness = 1.2
            textStroke.Parent = FpsTextLabel
        else
            FpsGui.Enabled = true
        end

        local frameCount = 0
        local lastCheck = os.clock()
        local currentFps = 0

        if FpsConnection then FpsConnection:Disconnect() end
        FpsConnection = RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = os.clock()
            if now - lastCheck >= 1 then
                currentFps = math.floor(frameCount / (now - lastCheck))
                frameCount = 0
                lastCheck = now
            end
        end)

        if StatsTask then task.cancel(StatsTask) end
        StatsTask = task.spawn(function()
            while true do
                if FpsTextLabel and FpsTextLabel.Parent then
                    local ping = 0
                    pcall(function()
                        ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
                    end)

                    FpsTextLabel.Text = string.format("FPS: %d | PING: %dms", currentFps, ping)
                    
                    if FpsFrame and FpsFrame:FindFirstChild("TemaStroke") and _G.CorTemaAtual then
                        FpsFrame.TemaStroke.Color = _G.CorTemaAtual
                    end
                end
                task.wait(0.5)
            end
        end)
    else
        if FpsConnection then FpsConnection:Disconnect() FpsConnection = nil end
        if StatsTask then task.cancel(StatsTask) StatsTask = nil end
        if FpsGui then FpsGui.Enabled = false end
    end
end)

