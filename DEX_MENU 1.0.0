    ToggleBox.Position = UDim2.new(1, -50, 0.5, -10)
    ToggleBox.BackgroundTransparency = 1
    ToggleBox.ZIndex = 5
    ToggleBox.Parent = Row

    CreateToggleSwitch(ToggleBox, function(state)
        callback(state)
    end)
end

-- =============================================================================
-- [7. GESTÃO DE PERSISTÊNCIA ANTI-RESET (HUMANOID CONTROLLER)]
-- =============================================================================
local function ForceHumanoidProperties(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    local function apply()
        if ScriptStates["Velocidade"].Active then hum.WalkSpeed = ScriptStates["Velocidade"].Value end
        if ScriptStates["Pulo"].Active then hum.JumpPower = ScriptStates["Pulo"].Value end
    end

    apply()
    
    local speedCon = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(apply)
    local jumpCon = hum:GetPropertyChangedSignal("JumpPower"):Connect(apply)
    
    hum.Died:Connect(function()
        speedCon:Disconnect()
        jumpCon:Disconnect()
    end)
end

if LocalPlayer.Character then task.spawn(ForceHumanoidProperties, LocalPlayer.Character) end
local charCon = LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    ForceHumanoidProperties(char)
    if ScriptStates["Câmera"].Active then workspace.CurrentCamera.FieldOfView = ScriptStates["Câmera"].Value end
end)
table.insert(MainConnections, charCon)

