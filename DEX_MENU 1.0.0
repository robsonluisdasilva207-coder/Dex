CreateSectionLabel(MenuPage, "Configurações do Painel")

local MenuDeSistema = {
    Color3.fromRGB(140, 20, 20),   -- 1. Vermelho Suave Original
    Color3.fromRGB(20, 100, 180),  -- 2. Azul Escuro Suave
    Color3.fromRGB(20, 140, 70),   -- 3. Verde Escuro
    Color3.fromRGB(30, 140, 140),  -- 4. Ciano Fosco
    Color3.fromRGB(170, 140, 10),  -- 5. Amarelo Queimado
    Color3.fromRGB(90, 40, 180),   -- 6. Roxo Escuro
    Color3.fromRGB(180, 40, 110),  -- 7. Rosa Suave
    Color3.fromRGB(170, 80, 10),   -- 8. Laranja Pastel
    Color3.fromRGB(160, 160, 160), -- 9. Cinza Fosco
    Color3.fromRGB(45, 45, 45)     -- 10. Grafite Suave
}

CreateAdvancedColorPicker(MenuPage, "Menu Cor", MenuDeSistema, function(novaCor)
    local corAntiga = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
    _G.CorTemaAtual = novaCor 

    local function AtualizarCoresPainel(objeto)
        if objeto.Name == "BolinhaDeCor" or objeto.Name == "BolinhaStroke" or objeto.Name == "ColorsGrid" then return end
        if objeto.Parent and (objeto.Parent.Name == "ColorsGrid" or objeto.Parent.Name == "BolinhaDeCor") then return end

        -- 1. Atualiza barras de Scroll
        if objeto:IsA("ScrollingFrame") then
            objeto.ScrollBarImageColor3 = novaCor
        end

        -- 2. UIStroke (Bordas)
        if objeto:IsA("UIStroke") then
            if objeto.Name == "TemaStroke" then
                objeto.Color = novaCor
                objeto.Transparency = 0.7
            elseif objeto.Color == corAntiga or objeto.Color == Color3.fromRGB(140, 20, 20) then
                objeto.Color = novaCor
            end
        end
        
        -- 3. Textos
        if objeto:IsA("TextLabel") or objeto:IsA("TextButton") or objeto:IsA("TextBox") then
            if objeto.TextColor3 == corAntiga or objeto.Name == "TemaTexto" or objeto.TextColor3 == Color3.fromRGB(140, 20, 20) then
                objeto.TextColor3 = novaCor
            end
        end
        
        -- 4. Fundos, Trask/Pill dos Toggles e Botões Ativos
        if objeto:IsA("Frame") or objeto:IsA("TextButton") then
            if objeto.Name == "SliderBar" or objeto.Name == "TemaFundo" or objeto.Name == "ToggleActive" or objeto.Name == "SwitchOn" or objeto.Name == "ToggleBackground" or objeto.Name == "SwitchBackground" then
                objeto.BackgroundColor3 = novaCor
            elseif objeto.BackgroundColor3 == corAntiga or objeto.BackgroundColor3 == Color3.fromRGB(140, 20, 20) or objeto.BackgroundColor3 == Color3.fromRGB(80, 10, 10) then
                objeto.BackgroundColor3 = novaCor
            end
        end
        
        for _, filho in pairs(objeto:GetChildren()) do
            AtualizarCoresPainel(filho)
        end
    end

    if MainFrame then AtualizarCoresPainel(MainFrame) end
    MainUIStroke.Transparency = 0.3
    
    if listTabsButtons then
        for _, botao in pairs(listTabsButtons) do
            if botao.Name == "TabAtiva" then
                botao.BackgroundColor3 = novaCor
                botao.UIStroke.Color = novaCor
                botao.UIStroke.Transparency = 0.4
            end
        end
    end
end)

