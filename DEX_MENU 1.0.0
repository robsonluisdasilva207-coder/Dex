-- 2. CONFIGURAÇÃO DO BOTÃO: TP NPC
-- =============================================================================
local BtnTPNPC, ListaNPCs, MainNPC, SetaNPC, LayoutNPCs = CriarEstruturaLista("TP NPC")

local function FiltrarCategoriaNPC(npcName)
    local lower = string.lower(npcName)
    if string.find(lower, "shop") or string.find(lower, "vendedor") or string.find(lower, "store") or string.find(lower, "loja") then
        return "Lojas e Vendedores"
    elseif string.find(lower, "quest") or string.find(lower, "missao") or string.find(lower, "job") then
        return "Missões e Quests"
    else
        return "Outros NPCs"
    end
end

local function CriarBotaoCategoriaNPC(nomeCategoria)
    local CatBtn = Instance.new("TextButton")
    EstilitarBotaoMenu(CatBtn, "   ¤ Categoria: " .. nomeCategoria, true)
    CatBtn.BackgroundColor3 = Color3.fromRGB(30, 12, 12)
    CatBtn.TextColor3 = _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
    CatBtn.ZIndex = 5
    CatBtn.Parent = ListaNPCs
end

local function AtualizarListaNPCs()
    for _, child in ipairs(ListaNPCs:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local npcsAchados = {}
    pcall(function()
        for _, obj in ipairs(game.Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not game.Players:GetPlayerFromCharacter(obj) then
                local parteAlvo = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildOfClass("BasePart")
                if parteAlvo then
                    local cat = FiltrarCategoriaNPC(obj.Name)
                    if not npcsAchados[cat] then npcsAchados[cat] = {} end
                    table.insert(npcsAchados[cat], {Model = obj, Parte = parteAlvo})
                end
            end
        end
    end)
    
    for categoria, listaDeNpcs in pairs(npcsAchados) do
        CriarBotaoCategoriaNPC(categoria)
        for _, dados in ipairs(listaDeNpcs) do
            local ItemBtn = Instance.new("TextButton")
            EstilitarBotaoMenu(ItemBtn, "         ¤ " .. dados.Model.Name, true)
            ItemBtn.ZIndex = 5
            ItemBtn.Parent = ListaNPCs
            
            ItemBtn.MouseButton1Click:Connect(function()
                if dados.Parte and dados.Parte:IsA("BasePart") then
                    TeleportarSeguro(dados.Parte.Position)
                end
            end)
        end
    end
    ListaNPCs.Size = UDim2.new(1, 0, 0, LayoutNPCs.AbsoluteContentSize.Y)
end

VincularAcaoLista(BtnTPNPC, ListaNPCs, MainNPC, SetaNPC, LayoutNPCs, AtualizarListaNPCs)

