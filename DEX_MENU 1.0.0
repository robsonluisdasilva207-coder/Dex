-- =============================================================================
-- [SISTEMA DE VISUALS / ESP CORE - TAMANHO LIMITADO]
-- =============================================================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local function ObterCorMenu()
    return _G.CorTemaAtual or Color3.fromRGB(140, 20, 20)
end

local CorVillain = Color3.fromRGB(255, 30, 60)

-- Container Garantido
local ScreenContainer = LocalPlayer:WaitForChild("PlayerGui")

-- Função para criar/atualizar Highlight (Aura)
local function AplicarAura(objeto, corAura)
    if not objeto or not objeto.Parent then return end
    local highlight = objeto:FindFirstChild("ESPAura")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESPAura"
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0.1
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = objeto
    end
    highlight.FillColor = corAura
    highlight.OutlineColor = corAura
    highlight.Enabled = true
end

local function RemoverAura(objeto)
    if not objeto then return end
    local highlight = objeto:FindFirstChild("ESPAura")
    if highlight then
        highlight.Enabled = false
    end
end

-- Criar Tag de Nome
local function CriarEtiquetaPlayer(head, tagId)
    if not head or not head.Parent then return nil end
    
    local billboard = ScreenContainer:FindFirstChild(tagId)
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = tagId
        billboard.Size = UDim2.new(0, 160, 0, 45)
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.Parent = ScreenContainer
        
        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = billboard
    end
    billboard.Adornee = head
    billboard.Enabled = true
    return billboard:FindFirstChild("Label")
end

local function RemoverEtiqueta(tagId)
    local billboard = ScreenContainer:FindFirstChild(tagId)
    if billboard then
        billboard.Enabled = false
    end
end

-- Detecção de Vilões
local CargosVilao = {"murderer", "killer", "assassino", "assassin", "villain", "beast", "impostor", "traitor", "criminal"}
local ArmasVilao = {"knife", "gun", "weapon", "faca", "arma", "revolver", "pistol", "sword", "blade"}

local function EhVilao(player, char)
    if not player or not char then return false end

    for _, item in ipairs(player:GetChildren()) do
        if item:IsA("StringValue") or item:IsA("BoolValue") then
            local valLower = string.lower(tostring(item.Value))
            for _, cargo in ipairs(CargosVilao) do
                if string.find(valLower, cargo) then return true end
            end
        end
    end

    local function ChecarFerramentas(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local toolLower = string.lower(item.Name)
                for _, arma in ipairs(ArmasVilao) do
                    if string.find(toolLower, arma) then return true end
                end
            end
        end
        return false
    end

    return ChecarFerramentas(char) or ChecarFerramentas(player:FindFirstChild("Backpack"))
end

local function EhItemDropado(obj)
    if obj:IsA("Tool") then return true end
    if obj:IsA("Handle") and obj.Parent and obj.Parent:IsA("Model") then return true end
    local nomeLower = string.lower(obj.Name)
    local termos = {"gold", "diamond", "rare", "legendary", "gun", "knife", "coin", "drop"}
    for _, termo in ipairs(termos) do
        if string.find(nomeLower, termo) then return true end
    end
    return false
end

-- Loop de Atualização
RunService.Heartbeat:Connect(function()
    local corMenu = ObterCorMenu()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    local verPlayerAtivo = (ScriptStates["VerPlayer"] and ScriptStates["VerPlayer"].Active) or _G.esp_player_ativo
    local verItensAtivo = (ScriptStates["VerItens"] and ScriptStates["VerItens"].Active) or _G.esp_itens_ativo
    local verNpcAtivo = (ScriptStates["VerNPC"] and ScriptStates["VerNPC"].Active) or _G.esp_npc_ativo

    -- 1. PLAYERS
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local tagId = "PlayerTag_" .. player.Name
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")

            if verPlayerAtivo and char and hum and hum.Health > 0 and root and head then
                local ehInimigo = EhVilao(player, char)
                local corFinal = ehInimigo and CorVillain or corMenu

                AplicarAura(char, corFinal)

                local label = CriarEtiquetaPlayer(head, tagId)
                if label then
                    local dist = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                    label.Text = player.DisplayName .. "\n[" .. dist .. "m]"
                    label.TextColor3 = corFinal
                    
                    -- Mínimo de 11px e Máximo travado em 16px
                    label.TextSize = 11 + math.clamp(dist / 40, 0, 5)
                end
            else
                RemoverAura(char)
                RemoverEtiqueta(tagId)
            end
        end
    end

    -- 2. ITENS DROPADOS
    if verItensAtivo then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if not Players:GetPlayerFromCharacter(obj) and EhItemDropado(obj) then
                AplicarAura(obj, corMenu)
            end
        end
    else
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:FindFirstChild("ESPAura") and not Players:GetPlayerFromCharacter(obj) and not obj:FindFirstChildOfClass("Humanoid") then
                RemoverAura(obj)
            end
        end
    end

    -- 3. NPCs
    if verNpcAtivo then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    AplicarAura(obj, corMenu)
                else
                    RemoverAura(obj)
                end
            end
        end
    else
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) and obj:FindFirstChild("ESPAura") then
                RemoverAura(obj)
            end
        end
    end
end)

