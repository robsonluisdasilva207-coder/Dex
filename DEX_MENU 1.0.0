-- =============================================================================
-- [MOTORES DE MOVIMENTO: DASHER & TP SEGURANÇA]
-- =============================================================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local cooldownDash = false
local esferaVisivel = nil

-- Criar / Atualizar Esfera Dinâmica da Barreira
local function AtualizarBarreiraVisivel(posicao, raio)
    if not esferaVisivel or not esferaVisivel.Parent then
        esferaVisivel = Instance.new("Part")
        esferaVisivel.Name = "BarreiraSeguranca"
        esferaVisivel.Shape = Enum.PartType.Ball
        esferaVisivel.Material = Enum.Material.Glass
        esferaVisivel.Color = _G.CorTemaAtual or Color3.fromRGB(0, 180, 255)
        esferaVisivel.Transparency = 0.93
        esferaVisivel.CastShadow = false
        esferaVisivel.CanCollide = false
        esferaVisivel.Anchored = true
        esferaVisivel.Parent = Workspace
    else
        esferaVisivel.Color = _G.CorTemaAtual or Color3.fromRGB(0, 180, 255)
    end
    esferaVisivel.Size = Vector3.new(raio * 2, raio * 2, raio * 2)
    esferaVisivel.CFrame = CFrame.new(posicao)
end

local function RemoverBarreiraVisivel()
    if esferaVisivel then
        esferaVisivel:Destroy()
        esferaVisivel = nil
    end
end

local function DesativarColisao(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- Loop de Verificação
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not root or not hum or hum.Health <= 0 then return end

    -- 1. DASHER (Apenas TP Instantâneo)
    if _G.dasher_ativo and hum.MoveDirection.Magnitude > 0 and not cooldownDash then
        cooldownDash = true
        local direcao = hum.MoveDirection
        root.CFrame = root.CFrame + (direcao * 30)
        task.delay(0.15, function() cooldownDash = false end)
    end

    -- 2. SISTEMA TP SEGURANÇA
    if _G.tp_seguranca_ativo then
        AtualizarBarreiraVisivel(root.Position, _G.raio_seguranca)

        -- Anti-Void e Anti-Fling
        local velAbs = root.AssemblyLinearVelocity.Magnitude
        if root.Position.Y < -30 or velAbs > 180 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            if CheckpointSeguranca then
                root.CFrame = CheckpointSeguranca
            elseif #LocaisSalvos > 0 then
                root.CFrame = LocaisSalvos[#LocaisSalvos]
            else
                root.CFrame = CFrame.new(root.Position.X, 50, root.Position.Z)
            end
        end

        -- Busca pelo Invasor Mais Próximo na Barreira
        local alvoInvasor = nil
        local menorDistancia = _G.raio_seguranca

        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj ~= char and obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local outroRoot = obj:FindFirstChild("HumanoidRootPart")
                local outroHum = obj:FindFirstChildOfClass("Humanoid")

                if outroRoot and outroHum and outroHum.Health > 0 then
                    local dist = (root.Position - outroRoot.Position).Magnitude
                    if dist <= menorDistancia then
                        menorDistancia = dist
                        alvoInvasor = outroRoot
                    end
                end
            end
        end

        -- Realiza a Esquiva Lateral e Olha Direcionado para o Alvo
        if alvoInvasor and not cooldownDash then
            cooldownDash = true
            DesativarColisao(char)
            
            local lado = math.random(1, 2) == 1 and 18 or -18 -- Desvia 18m pra esquerda ou direita
            local novaPosicao = (root.CFrame * CFrame.new(lado, 0, 0)).Position
            
            -- Alinha a rotação do personagem virado para o invasor
            root.CFrame = CFrame.lookAt(novaPosicao, Vector3.new(alvoInvasor.Position.X, novaPosicao.Y, alvoInvasor.Position.Z))
            
            task.delay(0.25, function() cooldownDash = false end)
        end
    else
        RemoverBarreiraVisivel()
    end
end) 

