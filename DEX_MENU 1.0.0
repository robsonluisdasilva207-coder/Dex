local flyBodyGyro, flyBodyVelocity
local flyConnection
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- ---- [ ABA 1: PLAYER ] ------------------------------------------------------
CreateAdvancedScriptItem(PlayerPage, "Velocidade", 16, 250, 16, "Velocidade", function(val, active)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = active and val or 16 end
    end
end)

CreateAdvancedScriptItem(PlayerPage, "Pulo", 50, 300, 50, "Pulo", function(val, active)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.UseJumpPower = true 
            hum.JumpPower = active and val or 50
            if active then hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
        end
    end
end)

CreateAdvancedScriptItem(PlayerPage, "Fly", 10, 150, 50, "Fly", function(val, active)
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not active or not root or not hum then 
        if hum then hum.PlatformStand = false end
        return 
    end
    
    hum.PlatformStand = true
    
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.P = 9e4
    flyBodyGyro.maxTorque = Vector3.new(9e5, 9e5, 9e5)
    flyBodyGyro.cframe = root.CFrame
    flyBodyGyro.Parent = root
    
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.maxForce = Vector3.new(9e5, 9e5, 9e5)
    flyBodyVelocity.Parent = root
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not char or not root or not hum or not root:IsDescendantOf(workspace) then
            if flyConnection then flyConnection:Disconnect() end
            return
        end
        
        local camera = workspace.CurrentCamera
        flyBodyGyro.cframe = camera.CFrame
        
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        
        local moveDirection = hum.MoveDirection
        if moveDirection.Magnitude > 0 then
            local camCFrame = camera.CFrame
            local lookVector = camCFrame.LookVector
            local rightVector = camCFrame.RightVector
            local localMove = root.CFrame:VectorToObjectSpace(moveDirection)
            local finalDirection = (lookVector * -localMove.Z) + (rightVector * localMove.X)
            
            if finalDirection.Magnitude > 0 then
                flyBodyVelocity.velocity = finalDirection.Unit * val
            else
                flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
            end
        else
            flyBodyVelocity.velocity = Vector3.new(0, 0, 0)
        end
    end)
end)

local cameraConnection
CreateAdvancedScriptItem(PlayerPage, "Câmera", 70, 140, 70, "Câmera", function(val, active)
    if cameraConnection then cameraConnection:Disconnect() cameraConnection = nil end
    if active then
        workspace.CurrentCamera.FieldOfView = val
        cameraConnection = RunService.RenderStepped:Connect(function()
            if LocalPlayer then
                LocalPlayer.CameraMinZoomDistance = 5 
                LocalPlayer.CameraMaxZoomDistance = 100 
            end
        end)
    else
        workspace.CurrentCamera.FieldOfView = 70
        if LocalPlayer then
            LocalPlayer.CameraMinZoomDistance = 0.5 
            LocalPlayer.CameraMaxZoomDistance = 25
        end
    end
end)

-- =============================================================================
-- NOVO COMPONENTE: KILL AURA NPC
-- =============================================================================
local alcanceKillAura = 15 -- Valor padrão inicial
CreateAdvancedScriptItem(PlayerPage, "Kill Aura (NPC)", 5, 50, alcanceKillAura, "KillAuraNPC", function(val, active)
    alcanceKillAura = val
end)

-- Loop funcional do Kill Aura executado em segundo plano
task.spawn(function()
    while true do
        task.wait(0.1) -- Evita lagar o jogo
        
        -- Só executa se o estado "KillAuraNPC" estiver ativo na tabela de estados
        if ScriptStates["KillAuraNPC"] and ScriptStates["KillAuraNPC"].Active then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local tool = char and char:FindFirstChildOfClass("Tool") -- Procura uma arma equipada na mão
            
            if root and tool then
                for _, obj in ipairs(workspace:GetChildren()) do
                    -- Verifica se é um modelo, se tem um Humanoid e se NÃO é um jogador real
                    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not game.Players:GetPlayerFromCharacter(obj) then
                        local npcRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                        local npcHum = obj:FindFirstChildOfClass("Humanoid")
                        
                        if npcRoot and npcHum and npcHum.Health > 0 then
                            -- Calcula a distância entre você e o NPC
                            local distancia = (root.Position - npcRoot.Position).Magnitude
                            
                            if distancia <= alcanceKillAura then
                                -- Simula o ataque ativando a ferramenta equipada
                                tool:Activate()
                                
                                -- Cria um dano simulado tocando a parte interna do NPC se necessário
                                local handle = tool:FindFirstChild("Handle")
                                if handle then
                                    firetouchinterest(npcRoot, handle, 0)
                                    firetouchinterest(npcRoot, handle, 1)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

