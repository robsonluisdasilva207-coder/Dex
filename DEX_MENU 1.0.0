local TabBar = Instance.new("Frame")
TabBar.Name = "TabBar"
TabBar.Size = UDim2.new(1, -8, 0, 22)
TabBar.Position = UDim2.new(0, 4, 0, 24)
TabBar.BackgroundTransparency = 1
TabBar.ZIndex = 4
