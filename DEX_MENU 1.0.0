local TabListLayout = Instance.new("UIListLayout")
TabListLayout.FillDirection = Enum.FillDirection.Horizontal
TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
TabListLayout.Padding = UDim.new(0, 5)
TabListLayout.Parent = TabBar

local tabs = {Player = PlayerPage, Teleporte = TeleportPage, Menu = MenuPage}
local activeTabButton = nil
local listTabsButtons = {}

local function CreateTab(name, order)
    local Tab = Instance.new("TextButton")
    Tab.Size = UDim2.new(0, 75, 1, 0)
    Tab.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Tab.BackgroundTransparency = 0.8
    Tab.Text = name
    Tab.TextColor3 = Color3.fromRGB(130, 130, 130)
    Tab.Font = Enum.Font.SourceSansBold
    Tab.TextSize = 12
    Tab.LayoutOrder = order
    Tab.ZIndex = 5
    Tab.Parent = TabBar
    Instance.new("UICorner", Tab).CornerRadius = UDim.new(0, 4)
    
    local TabStroke = Instance.new("UIStroke", Tab)
    TabStroke.Color = Color3.fromRGB(30, 30, 30)
    TabStroke.Thickness = 1
    
    listTabsButtons[name] = Tab

    if name == "Player" then
        Tab.BackgroundTransparency = 0.65
        Tab.BackgroundColor3 = _G.CorTemaAtual
        Tab.TextColor3 = Color3.fromRGB(240, 240, 240)
        TabStroke.Color = _G.CorTemaAtual
        TabStroke.Transparency = 0.4
        Tab.Name = "TabAtiva"
        activeTabButton = Tab
    end

    Tab.MouseButton1Click:Connect(function()
        if activeTabButton and activeTabButton ~= Tab then
            activeTabButton.Name = "TextButton"
            TweenService:Create(activeTabButton, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
                BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = 0.8,
                TextColor3 = Color3.fromRGB(130, 130, 130)
            }):Play()
            TweenService:Create(activeTabButton.UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(30, 30, 30), Transparency = 0}):Play()
        end
        
        Tab.Name = "TabAtiva"
        TweenService:Create(Tab, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = _G.CorTemaAtual,
            BackgroundTransparency = 0.65,
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        TweenService:Create(TabStroke, TweenInfo.new(0.2), {Color = _G.CorTemaAtual, Transparency = 0.4}):Play()
        activeTabButton = Tab

        for tabName, page in pairs(tabs) do
            page.Visible = (tabName == name)
        end
    end)
end

CreateTab("Player", 1)
CreateTab("Teleporte", 2)
CreateTab("Menu", 3)

-- =============================================================================
-- [6. CONSTRUTORES DE COMPONENTES CUSTOMIZADOS]
-- =============================================================================
local function CreateToggleSwitch(parent, callback)
    local Switch = Instance.new("TextButton")
    Switch.Size = UDim2.new(0, 40, 0, 20)
    Switch.BackgroundColor3 = Color3.fromRGB(20, 15, 15)
    Switch.Text = ""
    Switch.ZIndex = parent.ZIndex
    Switch.Parent = parent
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)
    
    local toggleStroke = Instance.new("UIStroke", Switch)
    toggleStroke.Color = Color3.fromRGB(45, 25, 25)
    toggleStroke.Transparency = 0.5 -- Suave e transparente
    toggleStroke.Name = "BordaToggleFalsa"

    local Slot = Instance.new("Frame")
    Slot.Size = UDim2.new(0, 14, 0, 14)
    Slot.Position = UDim2.new(0, 3, 0, 3)
    Slot.BackgroundColor3 = Color3.fromRGB(110, 110, 110)
    Slot.ZIndex = parent.ZIndex
    Slot.Parent = Switch
    Instance.new("UICorner", Slot).CornerRadius = UDim.new(1, 0)

    local enabled = false
    Switch.MouseButton1Click:Connect(function()
        enabled = not enabled
        local targetX = enabled and 23 or 3
        local targetColor = enabled and _G.CorTemaAtual or Color3.fromRGB(110, 110, 110)
        local bgTargetColor = enabled and Color3.fromRGB(35, 15, 15) or Color3.fromRGB(20, 15, 15)
        local strokeTargetColor = enabled and _G.CorTemaAtual or Color3.fromRGB(45, 25, 25)

        Switch.Name = enabled and "TemaFundoToggle" or "TextButton"
        Slot.Name = enabled and "TemaFundo" or "Frame"

        TweenService:Create(Slot, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = UDim2.new(0, targetX, 0, 3), BackgroundColor3 = targetColor}):Play()
        TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = bgTargetColor}):Play()
        TweenService:Create(toggleStroke, TweenInfo.new(0.15), {Color = strokeTargetColor, Transparency = enabled and 0.4 or 0.5}):Play()
        
        callback(enabled)
    end)
end

local function CreateAdvancedScriptItem(targetPage, name, minVal, maxVal, defaultVal, stateKey, callback)
    local MainItem = Instance.new("Frame")
    MainItem.Size = UDim2.new(1, -6, 0, 32)
    MainItem.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    MainItem.BackgroundTransparency = 0.75 -- Mais escuro e transparente (Estilo suave)
    MainItem.ClipsDescendants = true
    MainItem.ZIndex = 4
    MainItem.Parent = targetPage
    Instance.new("UICorner", MainItem).CornerRadius = UDim.new(0, 5)
    
    local itemStroke = Instance.new("UIStroke", MainItem)
    itemStroke.Color = _G.CorTemaAtual
    itemStroke.Transparency = 0.7 -- Bordas dos scripts super transparentes
    itemStroke.Name = "TemaStroke"

    local TitleButton = Instance.new("TextButton")
    TitleButton.Size = UDim2.new(1, 0, 0, 32)
    TitleButton.BackgroundTransparency = 1
    TitleButton.Text = "   " .. name
    TitleButton.TextColor3 = Color3.fromRGB(190, 190, 190)
    TitleButton.Font = Enum.Font.SourceSansBold
    TitleButton.TextSize = 13
    TitleButton.TextXAlignment = Enum.TextXAlignment.Left
    TitleButton.ZIndex = 5
    TitleButton.Parent = MainItem

    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 0, 32)
    Arrow.Position = UDim2.new(1, -26, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "●"
    Arrow.TextColor3 = _G.CorTemaAtual
    Arrow.Name = "TemaTexto"
    Arrow.Font = Enum.Font.SourceSansBold
    Arrow.TextSize = 11
    Arrow.ZIndex = 5
    Arrow.Parent = TitleButton

    local ControlFrame = Instance.new("Frame")
    ControlFrame.Size = UDim2.new(1, 0, 0, 32)
    ControlFrame.Position = UDim2.new(0, 0, 0, 32)
    ControlFrame.BackgroundTransparency = 1
    ControlFrame.ZIndex = 5
    ControlFrame.Parent = MainItem

    local SliderBack = Instance.new("TextButton")
    SliderBack.Size = UDim2.new(1, -115, 0, 4)
    SliderBack.Position = UDim2.new(0, 15, 0.5, -2)
    SliderBack.BackgroundColor3 = Color3.fromRGB(30, 15, 15)
    SliderBack.Text = ""
    SliderBack.BackgroundTransparency = 0.4
    SliderBack.ZIndex = 5
    SliderBack.Parent = ControlFrame
    Instance.new("UICorner", SliderBack)

    local SliderBar = Instance.new("Frame")
    SliderBar.Size = UDim2.new(0, 0, 1, 0)
    SliderBar.BackgroundColor3 = _G.CorTemaAtual
    SliderBar.Name = "SliderBar"
    SliderBar.ZIndex = 5
    SliderBar.Parent = SliderBack
    Instance.new("UICorner", SliderBar)

    local SliderBtn = Instance.new("TextButton")
    SliderBtn.Size = UDim2.new(0, 12, 0, 12)
    SliderBtn.Position = UDim2.new(0, -6, 0.5, -6)
    SliderBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    SliderBtn.Text = ""
    SliderBtn.ZIndex = 6
    SliderBtn.Parent = SliderBack
    Instance.new("UICorner", SliderBtn).CornerRadius = UDim.new(1, 0)

    local ValueBox = Instance.new("TextBox")
    ValueBox.Size = UDim2.new(0, 35, 0, 18)
    ValueBox.Position = UDim2.new(1, -90, 0.5, -9)
    ValueBox.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    ValueBox.Text = tostring(defaultVal)
    ValueBox.TextColor3 = Color3.fromRGB(200, 200, 200)
    ValueBox.Font = Enum.Font.Code
    ValueBox.TextSize = 11
    ValueBox.ZIndex = 5
    ValueBox.Parent = ControlFrame
    Instance.new("UICorner", ValueBox).CornerRadius = UDim.new(0, 4)
    
    local boxStroke = Instance.new("UIStroke", ValueBox)
    boxStroke.Color = _G.CorTemaAtual
    boxStroke.Transparency = 0.7
    boxStroke.Name = "TemaStroke"

    local ToggleContainer = Instance.new("Frame")
    ToggleContainer.Size = UDim2.new(0, 40, 0, 20)
    ToggleContainer.Position = UDim2.new(1, -50, 0.5, -10)
    ToggleContainer.BackgroundTransparency = 1
    ToggleContainer.ZIndex = 5
    ToggleContainer.Parent = ControlFrame

    local currentVal = defaultVal
    local dragging = false
    local activeTouchInput = nil

    local function updateValue(newVal)
        currentVal = math.clamp(newVal, minVal, maxVal)
        ValueBox.Text = tostring(math.floor(currentVal))
        local percent = (currentVal - minVal) / (maxVal - minVal)
        
        SliderBar.Size = UDim2.new(percent, 0, 1, 0)
        SliderBtn.Position = UDim2.new(percent, -6, 0.5, -6)
        
        if ScriptStates[stateKey] then
            ScriptStates[stateKey].Value = currentVal
            if ScriptStates[stateKey].Active then
                callback(currentVal, true)
            end
        end
    end

    local function processInput(inputPosition)
        local absPos = SliderBack.AbsolutePosition
        local absSize = SliderBack.AbsoluteSize
        local percent = math.clamp((inputPosition.X - absPos.X) / absSize.X, 0, 1)
        local val = minVal + percent * (maxVal - minVal)
        updateValue(val)
    end

    local function iniciarArrasto(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
            dragging = true
            activeTouchInput = input
            targetPage.ScrollingEnabled = false
            processInput(input.Position)
        end
    end

    SliderBtn.InputBegan:Connect(iniciarArrasto)
    SliderBack.InputBegan:Connect(iniciarArrasto)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == activeTouchInput and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            processInput(input.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == activeTouchInput and dragging then
            dragging = false
            activeTouchInput = nil
            targetPage.ScrollingEnabled = true
        end
    end)

    ValueBox.FocusLost:Connect(function()
        local num = tonumber(ValueBox.Text)
        if num then updateValue(num) else updateValue(currentVal) end
    end)

    CreateToggleSwitch(ToggleContainer, function(state)
        if ScriptStates[stateKey] then
            ScriptStates[stateKey].Active = state
            callback(currentVal, state)
        end
    end)

    local isOpen = false
    TitleButton.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        local targetHeight = isOpen and 64 or 32 
        Arrow.Text = isOpen and "○" or "●"
        MainItem:TweenSize(UDim2.new(1, -6, 0, targetHeight), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
    end)
    updateValue(defaultVal)
end

